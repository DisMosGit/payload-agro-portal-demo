# PostgreSQL credentials used by the compose `db` service.
POSTGRES_USER=payload
POSTGRES_PASSWORD=change-me
POSTGRES_DB=payload

# URL for running the app on the host (`pnpm dev`, `pnpm test:int`).
# Compose rewrites the host to `db` for the app container; keep `127.0.0.1` here.
DATABASE_URL=postgres://payload:change-me@127.0.0.1:5432/payload

# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Public origin used for article canonical, Open Graph, and Twitter URLs.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Free, keyless MapLibre style URL used by the /service-points map. This is a
# public browser value, never a secret. Replace it with any MapLibre-compatible
# style when a production tile provider is chosen.
NEXT_PUBLIC_MAP_STYLE_URL=/map-style.json
